# ============================================================
# SkillBattle Frontend - Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in the values
# ============================================================

# Backend API URL (from Render.com deployment)
# Update this after deploying backend
NEXT_PUBLIC_API_URL=https://skillbattle-api-2026.onrender.com

# Clerk publishes this value to the browser; use the instance publishable key,
# never a Clerk secret key. Configure it in Vercel for Production and Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
