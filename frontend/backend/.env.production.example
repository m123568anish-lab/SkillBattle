# ============================================================
# SkillBattle Backend - Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in the actual values
# WARNING: Never commit .env.production with real secrets to git!
# ============================================================

# Application Settings
APP_NAME=SkillBattle
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ============================================================
# Security - REQUIRED for production
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_MIN_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# Database - Use Neon.tech for PostgreSQL
# ============================================================
# Get these values from Neon.tech dashboard
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/skillbattle_db?sslmode=require
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/skillbattle_db

# ============================================================
# CORS - Set to your frontend domain
# ============================================================
# After deploying frontend on Vercel, update this
ALLOWED_ORIGINS=https://skillbattle.vercel.app
CORS_ORIGINS=https://skillbattle.vercel.app

# ============================================================
# Redis (Optional - for caching)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI Providers (Optional)
# ============================================================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
AI_PROVIDER=ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# File Uploads
# ============================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520

# ============================================================
# Database Initialization
# ============================================================
RESET_DB=false