# Environment variables for local development / production example
# Copy to .env and update secrets before running

# App
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-secure-random-value
HOST=0.0.0.0
PORT=8000

# Database (Postgres)
DATABASE_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=skillbattle_db
POSTGRES_USER=skillbattle
POSTGRES_PASSWORD=skillbattle

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
