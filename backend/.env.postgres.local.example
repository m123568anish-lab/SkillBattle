# ============================================
# SkillBattle Backend PostgreSQL Example
# Copy or rename this file to `.env.local` to switch development to PostgreSQL.
# ============================================

# App Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_TYPE=postgresql

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=skillbattle
POSTGRES_PASSWORD=skillbattle
POSTGRES_DB=skillbattle_db

# Async DB URL is built from the above settings by the application.

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production

# API Settings
HOST=0.0.0.0
PORT=8000

# AI Provider Keys (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
