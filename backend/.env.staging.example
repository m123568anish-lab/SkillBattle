# Placeholder-only staging configuration for the Neon SkillBattle project.
# Use values from the qubira-staging branch only. Never commit real values.

ENVIRONMENT=staging
DEBUG=false
DATABASE_READINESS_MODE=legacy
SECRET_KEY=<unique-staging-secret-at-least-32-characters>

# DATABASE_URL is used by the synchronous SQLAlchemy engine and startup checks.
DATABASE_URL=<staging-neon-sqlalchemy-url>

# ASYNC_DATABASE_URL must use postgresql+asyncpg:// and may use Neon pooling.
ASYNC_DATABASE_URL=<staging-neon-postgresql-plus-asyncpg-url>

# Only a one-off migration shell/job needs this direct, unpooled URL.
# Do not add MIGRATION_DATABASE_URL to the API or worker services.
MIGRATION_DATABASE_URL=<staging-neon-direct-postgresql-url>

# These values are for a one-off staging migration shell only.
# Do not add NEON_API_KEY or STAGING_MIGRATION_APPROVED to API/worker services.
NEON_API_KEY=<neon-management-api-key-used-only-for-read-identity-calls>
EXPECTED_NEON_PROJECT_ID=<expected-neon-project-id>
EXPECTED_NEON_BRANCH_ID=<expected-qubira-staging-branch-id>
EXPECTED_DATABASE_NAME=neondb
EXPECTED_DATABASE_ROLE=neondb_owner
# Historical Phase 12 expectation only; verify live staging revision separately.
EXPECTED_CURRENT_MIGRATION_REVISION=d1f5a8e7c2b4
TARGET_MIGRATION_REVISION=f9a1b2c3d4e5
STAGING_MIGRATION_APPROVED=false

ALLOWED_ORIGINS=<staging-frontend-origin>
NEON_AUTH_BASE_URL=<staging-neon-auth-base-url-if-used>
NEON_AUTH_JWKS_URL=<staging-neon-auth-jwks-url-if-used>

# Keep all production email credentials absent in staging.
RESEND_API_KEY=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Qubira Staging <no-reply@staging.invalid>
SMTP_FROM=Qubira Staging <no-reply@staging.invalid>

AI_PROVIDER=<approved-staging-provider>
OPENAI_API_KEY=<staging-only-key-if-approved>
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=<staging-ollama-endpoint-if-used>
OLLAMA_MODEL=llama3.1:8b

PLACEMENT_JOB_POLL_SECONDS=5
PLACEMENT_JOB_BATCH_SIZE=10
PLACEMENT_WORKER_NAME=qubira-placement-worker-staging
