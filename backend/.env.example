# SkillBattle Backend Environment Variables Template

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=SkillBattle
SECRET_KEY=generate_a_secure_64_character_random_string

# Clerk backend verification (keep secret values server-side only)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_ALLOWED_PARTIES=

# Live opportunity search and optional AI summaries
JSEARCH_API_KEY=
JSEARCH_COUNTRIES=us,in,gb,ca,au,de
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Neon PostgreSQL for Production / SQLite for Local Dev)
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/neondb?ssl=require

# CORS Security (Comma-separated allowed origins)
ALLOWED_ORIGINS=https://skillbattle.vercel.app,http://localhost:3000

# Resend Email Service for OTP Delivery
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=SkillBattle Verification <no-reply@yourdomain.com>

# Cloudinary Storage for Avatars and User Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
